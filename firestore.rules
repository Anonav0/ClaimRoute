rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ClaimRoute Secure Architecture Baseline:
    // All client operations must be mediated through the Node.js Express Backend
    // using the privileged Firebase Admin SDK.
    // Direct unauthenticated browser reads/writes are denied by default to protect
    // recipient addresses and one-time claim tokens.

    // Deny all direct client access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Future Authenticated Sender & Operations baseline (Phase 3+)
    match /users/{userId} {
      allow read, write: if false; // Mediated via backend
    }

    match /orders/{orderId} {
      allow read, write: if false; // Mediated via backend
    }

    match /claimTokens/{tokenHash} {
      allow read, write: if false; // Privileged server-only
    }

    match /recipients/{recipientId} {
      allow read, write: if false; // PII protected: server-only
    }

    match /deliveryConstraints/{constraintId} {
      allow read, write: if false; // Server-only
    }

    match /routingRequests/{requestId} {
      allow read, write: if false; // Server-only
    }
  }
}
